[sub_resource type="Shader" id="Shader_pattern"]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\n\nvoid vertex() {\n\tVERTEX.y += sin(VERTEX.x * 5.0 + VERTEX.z * 3.0) * 0.08;\n}\n\nvoid fragment() {\n\tvec2 cell = floor(UV * 10.0);\n\tfloat checker = mod(cell.x + cell.y, 2.0);\n\tALBEDO = mix(vec3(0.035, 0.32, 0.13), vec3(0.58, 0.78, 0.08), checker);\n\tROUGHNESS = mix(0.22, 0.68, checker);\n\tMETALLIC = 0.28;\n\tEMISSION = vec3(0.015, 0.05, 0.01) * (1.0 - checker);\n}\n"

