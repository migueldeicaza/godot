#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scene"
{
    def Mesh "EmissiveLens"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </Scene/Materials/BrakeMaterial>
    }

    def RectLight "BrakeAreaLight"
    {
        color3f inputs:color = (1, 0.1, 0.1)
        float inputs:exposure = 1
        float inputs:height = 0.25
        float inputs:intensity = 30
        asset inputs:texture:file = @../images/icon.png@
        float inputs:width = 0.5
    }

    def SphereLight "Headlight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        color3f inputs:color = (1, 0.95, 0.85)
        float inputs:exposure = 2
        float inputs:intensity = 40
        float inputs:radius = 0.15
        float inputs:shaping:cone:angle = 25
        float inputs:shaping:cone:softness = 0.2
    }

    def "Materials"
    {
        def Material "BrakeMaterial"
        {
            token outputs:surface.connect = </Scene/Materials/BrakeMaterial/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                color3f inputs:emissiveColor.connect = </Scene/Materials/BrakeGlow.outputs:rgb>
                float inputs:metallic = 0
                float inputs:opacity = 0.5
                float inputs:opacityThreshold = 0.3
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Shader "BrakeGlow"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../images/icon.png@
            float2 inputs:st.connect = </Scene/Materials/StReader.outputs:result>
            float3 outputs:rgb
        }

        def Shader "StReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }
}
